/* -----------------------------------------------------------------------------
 * 4096-point radix-4 DIF FFT, ported from sw/soc/fft_bm.c (same microcode and
 * twiddle ROM generated by tools/fft_plan.py).  The sample block is processed
 * in place at FFT_TD_RAM; the spectrum comes out in digit-reversed order, so
 * X[k] = data[rev4(k)] (base-4 digit reversal, see rev4() below).
 *
 * Included from sw/soc/ssb_bm.c (it relies on NPES, RING_DEPTH, DESC_BASE,
 * desc[], mmio_r/mmio_w, CGRA_BASE and the GPCP_* macros from gpcp_cgra.h).
 * -------------------------------------------------------------------------- */
#define FFT_TW_BASE      512
#define FFT_TW_WORDS     384
#define FFT_TILE_BFLIES  64
#define FFT_TAIL_BLOCK   64
#define FFT_TAIL_WORDS   128
#include "fft_stage_prog.h"   /* 编译器 image：与 fft_bm.c 共用 */
#include "fft_block_prog.h"
#define FFT_LUT_4096     3456ul
#define FFT_LUT_1024     384ul
#define FFT_LUT_256      0ul
#define FFT_LUT_TAIL     21888ul
#define FFT_LUT_RAM      0x80100000ul
#define FFT_TD_RAM       0x80300000ul
#define FFT_N            4096
/* 4096 点最多 64 个 tail tile / 48 个 stage tile；留 80 足够。
 * 必须收紧：两张编译器镜像是 static const，占约 50 KB .rodata，
 * 若这里仍按 128 预留，.bss 末尾会越过 RESULT_BASE(0x80010000)，
 * FFT 的 tile 数组和结果区互相踩（run-ssbfft / run-ssb-slot 会挂）。 */
#define FFT_MAX_TILES    80

static uint32_t f_dstart[FFT_MAX_TILES], f_in_end[FFT_MAX_TILES];
static uint32_t f_out_end[FFT_MAX_TILES], f_page[FFT_MAX_TILES];
static uint32_t f_cyc[FFT_MAX_TILES], f_in[FFT_MAX_TILES], f_out[FFT_MAX_TILES];
static uint32_t f_ntiles, f_ndesc, f_done;

/* 两张镜像由 cgra/kernels/fft_stage.yaml / fft_block.yaml 编译，
 * 与 sw/soc/fft_bm.c 用的是同一对头文件（含 include guard）。
 * 装载走拷贝引擎（gpcp_cgra_imem_load）：2480 字从逐字写的 18,248 拍
 * 降到 8,484 拍（docs/10 §13，2.15×）。 */
static void fe_load(uint32_t which)
{
    const uint32_t *p = which ? fft_block_prog : fft_stage_prog;
    uint32_t n = which ? FFT_BLOCK_PROG_CYCLES : FFT_STAGE_PROG_CYCLES;
    (void)gpcp_cgra_imem_load(CGRA_BASE, p, n * NPES);
}

static void fe_dsc(uint32_t ram, uint32_t spad, uint32_t len, uint32_t page,
                   uint32_t out, uint32_t stride, uint32_t row)
{
    uint32_t *d = desc[f_ndesc];
    d[0] = ram;
    d[1] = (spad & 0xFFFFu) | (page ? GPCP_DMA_DESC_PAGE1 : 0u) |
           (out ? GPCP_DMA_DESC_OUT : 0u);
    d[2] = len & 0xFFFFu;
    d[3] = (stride & 0xFFFFu) | ((row & 0xFFFFu) << 16);
    d[4] = 0; d[5] = 0; d[6] = 0; d[7] = 0;
    f_ndesc++;
}

static void fe_tile_begin(uint32_t page, uint32_t cyc)
{
    f_dstart[f_ntiles] = f_ndesc;
    f_page[f_ntiles] = page;
    f_cyc[f_ntiles] = cyc;
}

static void fe_tile_end(uint32_t in, uint32_t out)
{
    f_in[f_ntiles] = in;
    f_out[f_ntiles] = out;
    f_out_end[f_ntiles] = f_ndesc;
    f_ntiles++;
}

static void fe_desc_stages(uint32_t n, int32_t *data, uint32_t lut_ofs, uint32_t *pg)
{
    uint32_t tiles = n / 256, stages = 0;
    while ((n >> (2 * stages)) >= 256u)
        stages++;
    for (uint32_t st = 0; st < stages; st++) {
        uint32_t L = n >> (2 * st), M = L / 4;
        for (uint32_t q = 0; q < tiles; q++) {
            uint32_t page = (*pg)++;
            uint32_t base = q * FFT_TILE_BFLIES;
            uint32_t blk = base / M, t0 = base % M;
            fe_tile_begin(page & 1u, FFT_STAGE_PROG_CYCLES);
            for (uint32_t j = 0; j < 4; j++) {
                uint32_t g0 = blk * L + j * M + t0;
                fe_dsc((uint32_t)(uintptr_t)&data[2 * g0], j * 128, 128, page & 1u, 0, 0, 0);
            }
            fe_dsc(FFT_LUT_RAM + 4u * (lut_ofs + (st * tiles + q) * FFT_TW_WORDS),
                   FFT_TW_BASE, FFT_TW_WORDS, page & 1u, 0, 0, 0);
            f_in_end[f_ntiles] = f_ndesc;          /* in group ends here */
            for (uint32_t j = 0; j < 4; j++) {
                uint32_t g0 = blk * L + j * M + t0;
                fe_dsc((uint32_t)(uintptr_t)&data[2 * g0], j * 128, 128, page & 1u, 1, 0, 0);
            }
            fe_tile_end(5, 4);
        }
    }
}

static void fe_desc_tail(uint32_t n, int32_t *data, uint32_t *pg)
{
    for (uint32_t b = 0; b < n / FFT_TAIL_BLOCK; b++) {
        uint32_t page = (*pg)++;
        fe_tile_begin(page & 1u, FFT_BLOCK_PROG_CYCLES);
        fe_dsc((uint32_t)(uintptr_t)&data[b * FFT_TAIL_BLOCK * 2], 0,
               FFT_TAIL_WORDS, page & 1u, 0, 0, 0);
        fe_dsc(FFT_LUT_RAM + 4u * FFT_LUT_TAIL, FFT_TW_BASE, 120, page & 1u, 0, 0, 0);
        f_in_end[f_ntiles] = f_ndesc;              /* in group ends here */
        fe_dsc((uint32_t)(uintptr_t)&data[b * FFT_TAIL_BLOCK * 2], 0,
               FFT_TAIL_WORDS, page & 1u, 1, 0, 0);
        fe_tile_end(2, 1);
    }
}

static void fe_exec(uint32_t first, uint32_t last)
{
    for (uint32_t i = first; i < last; i++) {
        f_done = mmio_r(CGRA_BASE + GPCP_CGRA_RING_DONE);
        gpcp_cgra_write(CGRA_BASE, GPCP_CGRA_RING_BASE, DESC_BASE);
        gpcp_cgra_write(CGRA_BASE, GPCP_CGRA_RING_SIZE, RING_DEPTH);
        gpcp_cgra_write(CGRA_BASE, GPCP_CGRA_RING_HEAD, f_dstart[i]);
        gpcp_cgra_write(CGRA_BASE, GPCP_CGRA_RING_TAIL, f_in_end[i]);
        __asm__ __volatile__("fence iorw, iorw" ::: "memory");
        gpcp_cgra_write(CGRA_BASE, GPCP_CGRA_RING_CTRL, GPCP_CGRA_RING_EN);
        f_done += f_in[i];
        wait_desc(f_done);
        /* each tile runs on its own page: never start the array on page 0 */
        gpcp_cgra_array_start(CGRA_BASE, f_page[i], f_cyc[i]);
        __asm__ __volatile__("fence iorw, iorw" ::: "memory");
        {
            uint32_t spins = 0;
            while (mmio_r(CGRA_BASE + GPCP_CGRA_STATUS) & GPCP_CGRA_STATUS_BUSY) {
                if (++spins > 4000000u) { errs++; break; }
            }
        }
        runs++;
        gpcp_cgra_ring_push(CGRA_BASE, f_out_end[i]);
        f_done += f_out[i];
        wait_desc(f_done);
        mmio_w(CGRA_BASE + GPCP_CGRA_RING_CTRL, 0);
    }
}

/* 任意支持的 2 的幂：256 / 1024 / 4096。lut_ofs 选 tools/fft_plan.py 的 LUT 段。 */
static void fft_n(int32_t *data, uint32_t n, uint32_t lut_ofs)
{
    uint32_t pg = 0;
    fe_load(0);
    f_ntiles = 0;
    f_ndesc = 0;
    fe_desc_stages(n, data, lut_ofs, &pg);
    fe_exec(0, f_ntiles);

    fe_load(1);
    f_ntiles = 0;
    f_ndesc = 0;
    fe_desc_tail(n, data, &pg);
    fe_exec(0, f_ntiles);
}

static void fft4096(int32_t *data)
{
    fft_n(data, FFT_N, FFT_LUT_4096);
}

/* The engine is radix-4, so the output positions hold X[rev4(i)]: the base-4
 * digits of the index are reversed, *not* its bits (that is what a radix-2
 * transform would produce).  For 4096 points that is 6 base-4 digits. */
static uint32_t rev4n(uint32_t v, uint32_t digits)
{
    uint32_t r = 0;
    for (uint32_t d = 0; d < digits; d++) {
        r = (r << 2) | (v & 3u);
        v >>= 2;
    }
    return r;
}

static uint32_t rev4(uint32_t v)
{
    return rev4n(v, 6);
}
