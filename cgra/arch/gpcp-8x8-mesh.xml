<?xml version="1.0"?>
<!--
  GPCP CGRA 8x8 mesh (CGRA-ME ADL, adl0 方言)

  规模依据见 docs/10-cgra-me.md §8 / docs/02-cgra-isa.md：
    - 1 PE = 1 个 int16 MAC/cycle（对应本仓库 rtl/cgra 的 PE 数据通路）；
    - NR 20 MHz SISO 估算 ≈16 GOPS，8x8@500MHz 峰值 64 GOPS，留 3~4x 余量；
    - 目标工艺 Nangate45 下 8x8 的频率/面积留待 PPA 复测。

  拓扑：PE 阵列 8x8（共 64 个 PE），四周一圈 IO 端口；
        每个 PE 只有 N/E/W/S 四邻域输入，1 个输出端口。
  算子：add sub mul and or xor shl shr（与 rtl/cgra/cgra_pe.sv 的 ALU 模式一致）。
-->
<cgra>
  <module name="pe">
    <input name="in0"/> <!-- north -->
    <input name="in1"/> <!-- east  -->
    <input name="in2"/> <!-- west  -->
    <input name="in3"/> <!-- south -->
    <output name="out"/>
    <inst name="func" module="FuncUnit" if="(empty (mode))"/>
    <inst name="func" module="FuncUnit" if="(not (empty (mode)))" op="(mode)"/>
    <inst name="register" module="Register"/>
    <wire name="in_a"/> <wire name="in_b"/> <wire name="func_out"/>
    <connection select-from="this.in0 this.in1 this.in2 this.in3 register.out" to="in_a in_b"/>
    <connection from="in_a" to="func.in_a"/>
    <connection from="in_b" to="func.in_b"/>
    <connection select-from="in_a in_b func.out" to="func_out"/>
    <connection from="func_out" to="register.in"/>
    <connection select-from="func_out register.out" to="this.out"/>
  </module>

  <architecture col="10" row="10" cgra-cols="8" cgra-rows="8">
    <mesh out-north=".out"
          out-east=".out"
          out-west=".out"
          out-south=".out"
          in-north=".in0"
          in-east=".in1"
          in-west=".in2"
          in-south=".in3"
          io="every-side-port">
      <interior row="1">
        <block module="pe" mode="add sub mul and or xor shl shr"/>
      </interior>
    </mesh>
  </architecture>
</cgra>
